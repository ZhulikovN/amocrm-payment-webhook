[Unit]
Description=amoCRM Payment Webhook - FastAPI webhook service
After=network.target

[Service]
User=ubuntu
Group=ubuntu

WorkingDirectory=/home/ubuntu/amocrm-payment-webhook/current

EnvironmentFile=/home/ubuntu/amocrm-payment-webhook/current/.env

ExecStart=/home/ubuntu/.cache/pypoetry/virtualenvs/amocrm-payment-webhook-aAzxzKVC-py3.12/bin/uvicorn app.main:app --host 0.0.0.0 --port 8005

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

